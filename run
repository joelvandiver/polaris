#!/bin/bash

help=$(cat << EOF
usage [run <command>]
watch   start tests in watch mode
ci      run ci fmt, clippy, nextest, and test commands
tui     run the tui
wasm    build the wasm package into web/pkg
EOF
)

cmd=$1
shift

case "$cmd" in
    watch) cargo watch -x 'nextest run' ;;
    ci)
        # Autofix formatting issues
        cargo fmt --all
        cargo clippy --workspace --all-targets -- -D warnings
        cargo nextest run --workspace
        cargo test --workspace --doc
        ;;
    tui) cargo run -p polaris-tui -- "$@" ;;
    wasm) wasm-pack build crates/polaris-wasm --target web --out-dir ../../web/pkg "$@" ;;
    *) echo "$help"
esac
